pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	cls(0)
	state = "menu"
	plr_score = 0
	ai_score = 0
	plr = {
		x = 0,
		y = 60,
		sp = 7,
		spd = 1,
		w = 1,
		h = 2,
		f = false
	}
	ai = {
		x = 120,
		y = 60,
		sp = 9,
		spd= 1,
		w = 1,
		h = 2,
		f = false,
	}
end

function move_player()
	if (btn(⬆️)) plr.y -= plr.spd
	if (btn(⬆️)) ai.y -= ai.spd
	if (btn(⬇️)) plr.y += plr.spd
	if (btn(⬇️)) ai.y += ai.spd
end

function _update60()
	if state == "menu" then
		if btnp(❎) then
			state = "play"
			cls(0)
		end
	end
	if state == "play" then
		move_player()
	end
end

function _draw()
	if state == "play" then
		cls()
		print(plr_score, 57, 8, 7)
		print(ai_score, 68, 8, 7)
		spr(10, 10, 60, 1, 1)
		spr(plr.sp,plr.x,plr.y,plr.w,plr.h)
		spr(ai.sp,ai.x,ai.y,ai.w,ai.h)
		map(0,0,4,4,15,15)
	elseif state == "menu" then
		cls(6)
		w = print("press ❎ button to start",14, 60, 0)
	elseif state == "gameover" then
	
	end
	
end

