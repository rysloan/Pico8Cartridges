pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	cls(0)
	state = "gameover"
	plr_score = 0
	ai_score = 0
	init_ball()
	init_player()
	init_opp()
end

function _update60()
	-- menu state --
	if state == "menu" then
		if btnp(❎) then
			state = "play"
			cls(0)
		end
	end
	
	-- play state --
	if state == "play" then
		move_player()
		move_ball()
		opp_follow()
		player_bounce()
		ball_bounce()
		opp_bounce()
		reset_ball()
	end
	
	-- gameover state --
	if state == "gameover" then
		if btnp(❎) then
			state = "play"
			cls(0)
		end
		if btnp(🅾️) then
			state = "menu"
			cls()
		end
	end
end

function _draw()
	if state == "play" then
		cls()
		map(0,0,4,4,15,15)
		print(plr_score, 57, 8, 7)
		print(ai_score, 68, 8, 7)
		spr(ball.sp,ball.x,ball.y,ball.w,ball.h)
		spr(plr.sp,plr.x,plr.y,plr.w,plr.h)
		spr(ai.sp,ai.x,ai.y,ai.w,ai.h)
		--map(0,0,4,4,15,15)
		print(ball.dx, 10, 10, 2)
		print(ball.dy, 20, 20, 2)
		
	elseif state == "menu" then
		cls(6)
		w = print("press ❎ button to start",14, 60, 0)

	elseif state == "gameover" then
		cls(6)
		print("gameover",50, 30, 0)
		print("press ❎ button to restart",12, 50, 0)
		print("press z button to go to menu",9, 60, 0)
	end
	
end

-->8
-- ball

function init_ball()
	ball = {
		x = 64,
		y = 64,
		sp = 10,
		dx = 2,
		dy = 1,
		w = 1,
		h = 1,
		f = false,
	}
end

function move_ball()
	ball.x += ball.dx
	ball.y += ball.dy
end

function ball_bounce()
	if	ball.y > 115 then
		ball.dy = -ball.dy
	end
	if ball.y < 5 then
		ball.dy = -ball.dy
	end
end

function reset_ball()
	if ball.x > 128 then
		plr_score += 1
		ball.x = 64
		ball.y = 64
	end
	if ball.x < 0 then
		ai_score += 1
		ball.y = 64
		ball.x = 64
	end
end
-->8
-- opponent

function init_opp()
	ai = {
		x = 120,
		y = 60,
		sp = 9,
		spd = 1,
		w = 1,
		h = 2,
		f = false,
	}
end

function opp_follow()
	ai.y = ball.y
end

function opp_bounce()
	if ball.y >= ai.y and
				ball.y <= ai.y+15 and
				ball.x+5 >= ai.x+5 then
					ball.dx = -ball.dx
	end
end
-->8
-- player

function init_player()
	plr = {
		x = 0,
		y = 60,
		sp = 7,
		spd = 1,
		w = 1,
		h = 2,
		f = false
	}
end

function move_player()
	if (btn(⬆️)) plr.y -= plr.spd
	if (btn(⬇️)) plr.y += plr.spd
end

function player_bounce()
	if ball.y+2 >= plr.y and
				ball.y+2 <= plr.y+15 and
				ball.x+1 <= plr.x+2 then
				
					-- clean, rhythmic bounce angles (no uneven decimal drift)
					local angles = {
						{ dx = 1.5, dy = -1.5 }, -- top edge (45 deg up)
						{ dx = 2.0, dy = -1.0 }, -- upper-mid (shallow up)
						{ dx = 2.0, dy = -0.5 }, -- near-center up
						{ dx = 2.0, dy =  0.0 }, -- dead center (perfectly flat!)
						{ dx = 2.0, dy =  0.5 }, -- near-center down
						{ dx = 2.0, dy =  1.0 }, -- lower-mid (shallow down)
						{ dx = 1.5, dy =  1.5 }  -- bottom edge (45 deg down)
					}
					
					plr_c = plr.y + 8
					hit_offset = (ball.y) - plr_c
					
					
					norm_hit = hit_offset / ((8*plr.h) / 2)
					norm_hit = mid(-1,norm_hit,1)
					

					-- map hit position (-1 to 1) to an index from 1 to 7
					local idx = flr(((norm_hit + 1) / 2) * 6.99) + 1
					ball.dx = angles[idx].dx
					ball.dy = angles[idx].dy

					
					--[[plr_c = plr.y + 8
					hit_offset = (ball.y) - plr_c
					
					
					norm_hit = hit_offset / ((8*plr.h) / 2)
					norm_hit = mid(-1,norm_hit,1)
					
					max_angle = 0.166
					bounce_angle = norm_hit * max_angle
					
					speed = sqrt(((ball.dx)^2 + (ball.dy)^2) * 10)
					dir = ball.dx < 0 and 1 or -1
					
					ball.dx = dir * speed-- * cos(bounce_angle)
					ball.dy = speed-- * -sin(bounce_angle)
					
					ball.x = plr.x + 2]]
	end
end
